# Copy this file to api/.env and fill in your own values.
# api/.env is git-ignored; never commit real credentials.
#
# Used by the FastAPI app (api/main_optimized.py), scripts/train_model.py and
# every offline script via db_config.py.

DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-username
DB_PASSWORD=your-password
DB_NAME=your-database-name
